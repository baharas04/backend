generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Materi {
  id        Int      @id @default(autoincrement())
  judul     String
  deskripsi String
  link      String
  updatedAt DateTime @map("updatedat") @updatedAt
  createdAt DateTime @map("createdat") @default(now())
  sumber    String?

  @@map("Materi")
}

