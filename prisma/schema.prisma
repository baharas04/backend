generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Materi {
  id        Int      @id @default(autoincrement())
  judul     String
  deskripsi String
  link      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("Materi")
}

